+            result[name] = sorted([{key: value for key, value in row.items()
+                                    if key not in ('updatedAt', 'updated_at', 'lastSyncedAt')}
+                                   for row in rows], key=lambda row: row['id'])
+        return result
+
+
+def load_baseline(directory):
